page {
  min-height: 100vh;
  background: #f8eee4;
  color: #352a22;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx 28rpx 72rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.page-subtitle {
  margin-top: 12rpx;
  color: #806f63;
  font-size: 26rpx;
  line-height: 1.5;
}

.soft-card {
  margin-top: 28rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(88, 66, 49, 0.12);
  border-radius: 16rpx;
  background: rgba(255, 251, 245, 0.86);
  box-shadow: 0 16rpx 48rpx rgba(104, 73, 48, 0.08);
}

.primary-button {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #35302b;
  color: #fffaf3;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  word-break: keep-all;
}

.ghost-button {
  display: flex;
  min-height: 78rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(53, 48, 43, 0.18);
  border-radius: 999rpx;
  color: #4c4036;
  font-size: 28rpx;
  text-align: center;
  word-break: keep-all;
}

.muted-text {
  color: #8b7b70;
  font-size: 24rpx;
  line-height: 1.5;
}

.safe-bottom {
  height: 32rpx;
}
