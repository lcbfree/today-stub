<view class="page-shell preview-page">
  <view class="page-title">票根预览</view>
  <view class="page-subtitle">确认今天被怎样收好。</view>

  <view class="theme-tabs">
    <button
      wx:for="{{themes}}"
      wx:key="id"
      class="theme-tab {{item.id == theme.id ? 'is-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="switchTheme"
    >
      {{item.label}}
    </button>
  </view>

  <receipt-preview record="{{record}}" theme="{{theme}}" layout="{{layout}}" />

  <view wx:if="{{renderedImagePath}}" class="render-note">已生成临时图片，可用于下一步保存相册。</view>
  <view wx:if="{{renderError}}" class="render-error">{{renderError}}</view>

  <canvas
    canvas-id="receiptCanvas"
    class="render-canvas"
    style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
  ></canvas>

  <button class="ghost-button action" bindtap="renderImage">生成图片</button>
  <button class="primary-button action" bindtap="saveToArchive">存入今天</button>
  <button class="ghost-button action" bindtap="goArchive">去存档墙</button>
</view>
