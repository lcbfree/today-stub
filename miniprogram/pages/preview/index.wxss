.theme-tabs {
  display: flex;
  gap: 12rpx;
  margin: 30rpx 0 24rpx;
}

.theme-tab {
  flex: 1;
  min-height: 68rpx;
  border: 1rpx solid rgba(53, 48, 43, 0.16);
  border-radius: 999rpx;
  color: #6e5c50;
  font-size: 24rpx;
}

.theme-tab.is-active {
  background: #35302b;
  color: #fffaf3;
}

.render-note,
.render-error {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.render-note {
  color: #486b63;
}

.render-error {
  color: #b85c4b;
}

.render-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  pointer-events: none;
}

.save-feedback {
  margin-top: 26rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(53, 48, 43, 0.12);
  background: rgba(255, 250, 244, 0.9);
}

.save-feedback.is-success {
  border-color: rgba(72, 107, 99, 0.22);
}

.save-feedback.is-error {
  border-color: rgba(184, 92, 75, 0.28);
}

.save-message {
  color: #352a22;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.save-hint {
  margin-top: 12rpx;
  color: #756559;
  font-size: 25rpx;
  line-height: 1.55;
}

.settings-button {
  margin-top: 18rpx;
  color: #b85c4b;
  font-size: 25rpx;
  font-weight: 700;
  text-align: left;
}

.action {
  margin-top: 24rpx;
}
