.receipt-card {
  margin-top: 34rpx;
  padding: 34rpx 30rpx;
  border: 1rpx solid rgba(52, 43, 35, 0.16);
  border-radius: 10rpx;
  background: #fffaf1;
  color: #2f2924;
  box-shadow: 0 22rpx 60rpx rgba(88, 63, 42, 0.12);
}

.receipt-kicker {
  font-size: 22rpx;
  letter-spacing: 0;
  color: #8c7d72;
}

.receipt-title {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 800;
}

.receipt-row {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
  font-size: 26rpx;
}

.receipt-copy {
  margin-top: 30rpx;
  font-size: 30rpx;
  line-height: 1.6;
}

.trace-block {
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx dashed rgba(47, 41, 36, 0.22);
}

.receipt-proof {
  margin-top: 18rpx;
  color: #76685e;
  font-size: 24rpx;
  line-height: 1.5;
}

.receipt-stamp {
  display: inline-flex;
  margin-top: 30rpx;
  padding: 10rpx 16rpx;
  border: 2rpx solid #b85c4b;
  border-radius: 8rpx;
  color: #b85c4b;
  font-size: 24rpx;
  transform: rotate(-4deg);
}

.action {
  margin-top: 24rpx;
}
