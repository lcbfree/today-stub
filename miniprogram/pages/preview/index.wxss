.theme-tabs {
  display: flex;
  gap: 12rpx;
  margin: 30rpx 0 24rpx;
}

.theme-tab {
  flex: 1;
  min-height: 68rpx;
  border: 1rpx solid rgba(53, 48, 43, 0.16);
  border-radius: 999rpx;
  color: #6e5c50;
  font-size: 24rpx;
}

.theme-tab.is-active {
  background: #35302b;
  color: #fffaf3;
}

.render-note,
.render-error {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.render-note {
  color: #486b63;
}

.render-error {
  color: #b85c4b;
}

.render-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  pointer-events: none;
}

.action {
  margin-top: 24rpx;
}
