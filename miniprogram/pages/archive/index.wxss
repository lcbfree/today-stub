.empty-card {
  text-align: center;
}

.empty-title {
  color: #4a3d34;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 14rpx;
  color: #806f63;
  font-size: 25rpx;
  line-height: 1.5;
}

.month-tabs {
  display: flex;
  width: 100%;
  margin-top: 30rpx;
  white-space: nowrap;
}

.month-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-width: 178rpx;
  min-height: 84rpx;
  margin-right: 14rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(53, 48, 43, 0.14);
  border-radius: 16rpx;
  color: #6e5c50;
  font-size: 24rpx;
  text-align: left;
}

.month-tab text + text {
  margin-top: 6rpx;
  color: #9a887b;
  font-size: 21rpx;
}

.month-tab.is-active {
  background: #35302b;
  color: #fffaf3;
}

.month-tab.is-active text + text {
  color: rgba(255, 250, 243, 0.72);
}

.calendar-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: rgba(255, 251, 245, 0.72);
}

.day-pill {
  display: flex;
  width: 72rpx;
  min-height: 72rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(72, 107, 99, 0.18);
  border-radius: 14rpx;
  background: #fffaf3;
}

.day-pill.has-many {
  border-color: rgba(184, 92, 75, 0.28);
}

.day-number {
  color: #352a22;
  font-size: 25rpx;
  font-weight: 700;
}

.day-count {
  margin-top: 2rpx;
  color: #b85c4b;
  font-size: 19rpx;
}

.archive-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 28rpx;
}

.day-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.day-heading {
  display: flex;
  justify-content: space-between;
  color: #806f63;
  font-size: 24rpx;
}

.action {
  margin-top: 24rpx;
}
