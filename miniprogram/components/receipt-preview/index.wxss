.receipt-preview {
  position: relative;
  overflow: hidden;
  padding: 42rpx 34rpx 38rpx;
  border: 1rpx solid rgba(52, 43, 35, 0.16);
  border-radius: 10rpx;
  box-shadow: 0 22rpx 60rpx rgba(88, 63, 42, 0.12);
}

.receipt-kicker {
  font-size: 22rpx;
  letter-spacing: 0;
  line-height: 1.3;
}

.receipt-title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
}

.receipt-divider {
  margin: 28rpx 0 24rpx;
  border-top: 1rpx dashed rgba(47, 41, 36, 0.22);
}

.receipt-row {
  display: flex;
  justify-content: space-between;
  gap: 28rpx;
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.45;
}

.receipt-row-label {
  flex: 0 0 160rpx;
}

.receipt-row-value {
  flex: 1;
  text-align: right;
  word-break: break-all;
}

.receipt-section {
  margin-top: 26rpx;
}

.receipt-main-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 16rpx;
  font-size: 31rpx;
  font-weight: 650;
  line-height: 1.55;
}

.receipt-small-copy,
.receipt-verdict {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.55;
}

.receipt-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 34rpx;
}

.receipt-stamp {
  max-width: 240rpx;
  padding: 10rpx 16rpx;
  border: 2rpx solid;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  transform: rotate(-4deg);
}

.receipt-object {
  font-size: 22rpx;
}
