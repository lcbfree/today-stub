.stub-card {
  position: relative;
  padding: 28rpx;
  border: 1rpx solid rgba(88, 66, 49, 0.12);
  border-radius: 14rpx;
  background: #fffaf3;
  box-shadow: 0 14rpx 34rpx rgba(104, 73, 48, 0.08);
}

.stub-card.is-stacked::before,
.stub-card.is-stacked::after {
  position: absolute;
  z-index: -1;
  right: 14rpx;
  left: 14rpx;
  height: 18rpx;
  border-radius: 12rpx;
  background: rgba(255, 250, 243, 0.78);
  content: "";
}

.stub-card.is-stacked::before {
  bottom: -10rpx;
}

.stub-card.is-stacked::after {
  bottom: -18rpx;
  right: 28rpx;
  left: 28rpx;
}

.stub-top {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.stub-date,
.stub-count {
  color: #8b7b70;
  font-size: 22rpx;
}

.stub-count {
  font-weight: 700;
}

.stub-title {
  margin-top: 10rpx;
  color: #352a22;
  font-size: 30rpx;
  font-weight: 700;
}

.stub-copy {
  margin-top: 12rpx;
  color: #66564a;
  font-size: 26rpx;
  line-height: 1.5;
}

.stub-trace {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.stub-trace text {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #efe2d5;
  color: #735f51;
  font-size: 21rpx;
}
