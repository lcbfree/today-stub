.life-modules {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.module-card {
  padding: 20rpx;
  border: 1rpx solid rgba(89, 68, 50, 0.12);
  border-radius: 16rpx;
  background: rgba(255, 252, 247, 0.88);
}

.module-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.module-label {
  color: #3d3028;
  font-size: 28rpx;
  font-weight: 700;
}

.module-placeholder {
  margin-top: 8rpx;
  color: #99887a;
  font-size: 22rpx;
}

.module-toggle {
  min-width: 108rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #efe2d5;
  color: #6f5d50;
  font-size: 24rpx;
}

.module-toggle.is-on {
  background: #35302b;
  color: #fffaf3;
}

.module-input {
  margin-top: 18rpx;
  min-height: 72rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #f7ecdf;
  color: #3d3028;
  font-size: 26rpx;
}

.module-note {
  margin-top: 12rpx;
  color: #9a7566;
  font-size: 22rpx;
  line-height: 1.45;
}
