.status-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.status-card {
  min-height: 176rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(89, 68, 50, 0.14);
  border-radius: 16rpx;
  background: rgba(255, 252, 247, 0.88);
  color: #3b3028;
  text-align: left;
}

.status-card.is-active {
  border-color: rgba(184, 92, 75, 0.58);
  background: #fff6ed;
  box-shadow: inset 0 0 0 2rpx rgba(184, 92, 75, 0.12);
}

.status-icon {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #efe2d5;
  color: #8c5e4e;
  font-size: 24rpx;
  font-weight: 700;
}

.status-label {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.status-desc {
  margin-top: 8rpx;
  color: #8a796c;
  font-size: 22rpx;
  line-height: 1.4;
}
